{
  "profiles": {
    "docker": {
      "anyFiles": [
        "Dockerfile",
        "Dockerfile.e2e"
      ],
      "recommended": [
        "hadolint",
        "docker compose config",
        "build",
        "Trivy",
        "SBOM"
      ]
    },
    "frontend": {
      "anyFiles": [
        "playwright.config.ts",
        "playwright.config.js",
        "cypress.config.ts",
        "cypress.config.js"
      ],
      "recommended": [
        "browser E2E",
        "accessibility",
        "pinned browser image"
      ]
    },
    "go": {
      "anyFiles": [
        "go.mod"
      ],
      "recommended": [
        "gofmt",
        "go vet",
        "go test -race",
        "staticcheck",
        "govulncheck"
      ]
    },
    "java": {
      "anyFiles": [
        "pom.xml",
        "build.gradle",
        "build.gradle.kts"
      ],
      "recommended": [
        "wrapper verify",
        "tests",
        "Checkstyle or SpotBugs",
        "dependency audit"
      ]
    },
    "kubernetes": {
      "anyFiles": [
        "Chart.yaml",
        "kustomization.yaml"
      ],
      "recommended": [
        "helm lint",
        "kubeconform",
        "OPA/Conftest"
      ]
    },
    "node": {
      "anyFiles": [
        "package.json"
      ],
      "recommended": [
        "npm ci",
        "lint",
        "typecheck",
        "test",
        "dependency audit"
      ]
    },
    "python": {
      "anyFiles": [
        "pyproject.toml",
        "requirements.txt"
      ],
      "recommended": [
        "ruff",
        "mypy",
        "pytest",
        "bandit",
        "pip-audit"
      ]
    },
    "rust": {
      "anyFiles": [
        "Cargo.toml"
      ],
      "recommended": [
        "cargo fmt --check",
        "cargo clippy -- -D warnings",
        "cargo test",
        "cargo deny"
      ]
    },
    "terraform": {
      "anyFiles": [
        "main.tf",
        "versions.tf"
      ],
      "recommended": [
        "terraform fmt -check",
        "terraform validate",
        "tflint",
        "checkov"
      ]
    }
  },
  "schema": "new-project.stack-profiles/v1"
}
