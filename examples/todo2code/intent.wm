#!/usr/bin/env wellm-typed
#@wellmanifest kind="data" schema="intent.schema.json"

schema: Literal<"new-project.intent/v2"> = "new-project.intent/v2"
ticket: TicketId = "ticket-002"
summary: NonEmptyString = "Integracja adopcji manifestu z goal"
workstream: WorkstreamId = "integration"
allowedPaths: UniqueList<RelativeGlob> = [
  "scripts/create_adoption_lock.py",
  "tests/adoption-lock.test.sh",
  "docs/GOAL_ADOPTION.md",
  "docs/ROADMAP_AFTER_0.9.0.md",
  "README.md",
  "project/ticket-002/**",
  "TODO.md",
  "project/TICKETS.md"
]
forbiddenPaths: UniqueList<RelativeGlob> = ["project/ticket-*/user-*.md"]
stacks: UniqueList<StackId> = ["python"]
dependsOn: UniqueList<TicketId> = []
conflictsWith: UniqueList<TicketId> = []
integrationTicket: TicketId | Null = null
