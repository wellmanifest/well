# Generated from config/env-contract.json by `make env-sync`.
# Copy to .env and keep secrets local. Values below are development defaults.

# [docker]
# Explicit E2E subnet, avoiding Docker default-pool exhaustion.
WELLMANIFEST_E2E_SUBNET=172.30.242.0/24
# Host gRPC port.
WELLMANIFEST_GRPC_HOST_PORT=50051
# Host HTTP port.
WELLMANIFEST_HTTP_HOST_PORT=8080
# Runtime image repository.
WELLMANIFEST_IMAGE=wellmanifest/wellm
# Runtime image tag.
WELLMANIFEST_IMAGE_TAG=0.2.0rc4-dev
# IoT backend host port.
WELLMANIFEST_IOT_BACKEND_PORT=8091
# IoT frontend host port.
WELLMANIFEST_IOT_FRONTEND_PORT=8090
# IoT MQTT host port.
WELLMANIFEST_IOT_MQTT_PORT=1884
# Explicit three-layer IoT subnet.
WELLMANIFEST_IOT_SUBNET=172.30.243.0/24
# Host MQTT port.
WELLMANIFEST_MQTT_HOST_PORT=1883
# Explicit public Compose subnet.
WELLMANIFEST_PUBLIC_SUBNET=172.30.240.0/24
# Explicit runtime Compose subnet.
WELLMANIFEST_RUNTIME_SUBNET=172.30.241.0/24
# Host landing page port.
WELLMANIFEST_WWW_HOST_PORT=8088

# [grpc]
# gRPC bind address.
WELLMANIFEST_GRPC_ADDRESS=0.0.0.0:50051
# gRPC client target.
WELLMANIFEST_GRPC_TARGET=localhost:50051
# gRPC worker count.
WELLMANIFEST_GRPC_WORKERS=8

# [integration]
# todo2code CLI command used by the intent integration target.
TODO2CODE_BIN=t2c
# Optional local todo2code image.
TODO2CODE_IMAGE=todo2code:local
# Output directory for Wellm/todo2code format evidence.
TODO2CODE_OUTPUT_DIR=.intent/wellm-formats
# Optional todo2code A2A bearer token.
# secret: never commit a real value
TODO2CODE_TOKEN=
# todo2code A2A base URL.
TODO2CODE_URL=http://localhost:8787

# [iot]
# Firmware simulator device identifier.
WELLMANIFEST_IOT_DEVICE_ID=rpi-sim-001
# Exit firmware simulator after one acknowledged sample.
WELLMANIFEST_IOT_RUN_ONCE=1
# Firmware telemetry interval in seconds.
WELLMANIFEST_IOT_SAMPLE_INTERVAL=1.0

# [mqtt]
# E2E MQTT client host.
MQTT_HOST=mqtt
# MQTT broker hostname.
WELLMANIFEST_MQTT_HOST=mqtt
# Optional MQTT password.
# secret: never commit a real value
WELLMANIFEST_MQTT_PASSWORD=
# MQTT broker port.
WELLMANIFEST_MQTT_PORT=1883
# Bridge subscription topic.
WELLMANIFEST_MQTT_REQUEST_TOPIC=wellmanifest/v1/default/request/#
# Optional MQTT username.
WELLMANIFEST_MQTT_USERNAME=
# Protocol tenant identifier.
WELLMANIFEST_TENANT=default

# [release]
# Docker E2E result recorded in release metadata.
WELLMANIFEST_DOCKER_RESULT=not-run
# Local E2E result recorded in release metadata.
WELLMANIFEST_E2E_RESULT=not-run
# Environment contract verification recorded in release metadata.
WELLMANIFEST_ENV_RESULT=not-run
# Governance build result recorded in release metadata.
WELLMANIFEST_GOVERNANCE_RESULT=not-run
# Multi-format intent analysis result recorded in release metadata.
WELLMANIFEST_INTENT_RESULT=not-run
# Three-layer IoT/firmware result recorded in release metadata.
WELLMANIFEST_IOT_RESULT=not-run
# Node test result recorded in release metadata.
WELLMANIFEST_NODE_TEST_RESULT=not-run
# npm package smoke result recorded in release metadata.
WELLMANIFEST_NPM_PACKAGE_RESULT=not-run
# Python test result recorded in release metadata.
WELLMANIFEST_PYTHON_TEST_RESULT=not-run
# Ruff result recorded in release metadata.
WELLMANIFEST_RUFF_RESULT=not-run
# Rust/WASM result recorded in release metadata.
WELLMANIFEST_RUST_RESULT=not-run
# Source archive smoke result recorded in release metadata.
WELLMANIFEST_SOURCE_ARCHIVE_RESULT=not-run
# Bidirectional schema typing result recorded in release metadata.
WELLMANIFEST_TYPING_RESULT=not-run
# Version registry verification recorded in release metadata.
WELLMANIFEST_VERSION_RESULT=not-run
# Wheel smoke result recorded in release metadata.
WELLMANIFEST_WHEEL_RESULT=not-run

# [runtime]
# Client-side contract reference.
WELLMANIFEST_CONTRACT=contract:firmware-thin
# Contract registry path.
WELLMANIFEST_CONTRACTS=/app/config/contracts.json
# Default Contract AQL reference.
WELLMANIFEST_DEFAULT_CONTRACT=contract:dev
# Development-only URI allow switch.
WELLMANIFEST_DEV_ALLOW=0
# Enable remote Plesk execution endpoint.
WELLMANIFEST_ENABLE_PLESK_EXECUTION=0
# Append-only event store path.
WELLMANIFEST_EVENT_STORE=/data/events.jsonl
# HTTP bind host.
WELLMANIFEST_HOST=0.0.0.0
# Documented request body budget.
WELLMANIFEST_MAX_BODY_BYTES=1048576
# HTTP bind/container port.
WELLMANIFEST_PORT=8080
# Enable Uvicorn reload in development.
WELLMANIFEST_RELOAD=0
# Optional HTTP bearer-style gateway token.
# secret: never commit a real value
WELLMANIFEST_TOKEN=
# Public/client runtime URL.
WELLMANIFEST_URL=http://localhost:8080
# Allowed workspace root for publication planning.
WELLMANIFEST_WORKSPACE_ROOT=/workspace

# [security]
# Optional LiteLLM/OpenRouter benchmark key.
# secret: never commit a real value
OPENROUTER_API_KEY=
# Signed single-use apply grant.
# secret: never commit a real value
URIRUN_APPLY_GRANT=
# Trusted urirun bridge/node URL.
URIRUN_NODE_URL=http://urirun-bridge:8080
# urirun bridge token.
# secret: never commit a real value
URIRUN_TOKEN=

# [test]
# Allow make e2e to skip Docker only when explicitly enabled.
WELLMANIFEST_E2E_ALLOW_LOCAL_FALLBACK=0
# Local E2E HTTP port.
WELLMANIFEST_E2E_PORT=18080
