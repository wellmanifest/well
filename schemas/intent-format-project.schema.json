{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wellmanifest/wellm/v0.2.0rc4/schemas/intent-format-project.schema.json",
  "title": "Wellm multi-format intent project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "representations"],
  "properties": {
    "schema": {"const": "wellm.intent-format-project/v1"},
    "id": {"type": "string", "minLength": 1},
    "schemaRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "preferredAuthoring": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "representations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "dialect": {"type": "string", "default": "auto"},
          "role": {"type": "string", "default": "representation"}
        }
      }
    }
  }
}
