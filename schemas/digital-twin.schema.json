{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.org/schemas/digital-twin.schema.json",
  "title": "WellManifest read-only digital twin portrait",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "id", "principal", "contractStatus", "allowedCapabilities", "specializations", "workload"],
  "properties": {
    "schema": {"const": "wellmanifest.digital-twin/v1"},
    "id": {"type": "string", "minLength": 1},
    "principal": {"type": "string", "minLength": 1},
    "actorKind": {"enum": ["human", "bot", "service", "device"]},
    "contractStatus": {"enum": ["active", "suspended", "revoked", "missing"]},
    "allowedCapabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "specializations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "workload": {"type": "number", "minimum": 0},
    "revisionHash": {"type": "string"},
    "autonomy": {
      "type": "object",
      "properties": {"enabled": {"const": false}}
    }
  },
  "not": {
    "anyOf": [
      {"required": ["password"]},
      {"required": ["token"]},
      {"required": ["secret"]},
      {"required": ["credential"]}
    ]
  }
}
